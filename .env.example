# Exemplos locais: substitua antes de executar. A API não carrega .env automaticamente.
DB_SERVER=localhost
DB_PORT=3306
DB_DATABASE=controle_operacional
DB_USER=controle_operacional
DB_PASSWORD=configure-uma-senha-local
# Alternativa aos DB_* acima:
# DB_CONNECTION_STRING=Server=localhost;Port=3306;Database=controle_operacional;User=controle_operacional;Password=configure-uma-senha-local;
JWT_SECRET=substitua-por-um-segredo-aleatorio-com-32-caracteres-ou-mais
JWT_EXPIRATION=86400000
JWT_ISSUER=sistema-controle-operacional-api
JWT_AUDIENCE=sistema-controle-operacional-api
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=usuario-smtp
MAIL_PASSWORD=configure-credencial-smtp
MAIL_FROM=noreply@example.com
APP_FRONTEND_URL=http://localhost:5173
SWAGGER_ENABLED=true
